# Credenciales de EMI Telegestión
EMI_USERNAME=tu_email@ejemplo.com
EMI_PASSWORD=tu_contraseña

# Umbrales de alerta de consumo diario
# Umbral fijo en litros (ej: 1000 litros = 1 m3 al día)
ALERT_THRESHOLD_LITERS=1000
# Multiplicador sobre la media histórica/habitual (ej: 2.0 = avisa si consumes más del doble de tu media)
ALERT_MULTIPLIER_MEAN=2.0

# Opcional: Notificaciones por Telegram (puedes poner varios IDs separados por coma: 12345678,87654321)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: PIN de seguridad de 4 dígitos para acceder al Dashboard Web (ejemplo: 1234)
DASHBOARD_PIN=1234

# Opcional: URL pública del Dashboard (ej. https://juanancg.github.io/GotaBot/)
DASHBOARD_URL=

# Opcional: Notificaciones por Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
